<Window x:Class="WorkTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorkTime.ViewModels"
        xmlns:ctrl="clr-namespace:WorkTime.Controls"
        Title="WorkTime"
        Width="640" Height="720"
        MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Rectangle Width="6" Height="22"
                               Fill="{StaticResource AccentBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="10" Height="6"
                               Fill="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,8,8,0"
                               RadiusX="1" RadiusY="1"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WorkTime" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="作業時間を「ただ計る」だけじゃない。"
                           Foreground="{StaticResource TextSubBrush}"
                           FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="自動検知"
                          IsChecked="{Binding AutoDetectEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <Button Content="設定" Style="{StaticResource GhostButton}" Click="OnOpenSettings"/>
            </StackPanel>
        </Grid>

        <!-- ステータス行 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="running">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="paused">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusDetail}"
                           Foreground="{StaticResource TextSubBrush}"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="{Binding ToggleButtonLabel}"
                        Command="{Binding ToggleCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- フリップ時計 -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ctrl:FlipCard Grid.Column="0" Margin="0,0,8,0"
                           Value="{Binding Hours}" Label="時"/>
            <ctrl:FlipCard Grid.Column="1" Margin="4,0,4,0"
                           Value="{Binding Minutes}" Label="分"/>
            <ctrl:FlipCard Grid.Column="2" Margin="8,0,0,0"
                           Value="{Binding Seconds}" Label="秒"/>
        </Grid>

        <!-- スコープ切替 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <ToggleButton Content="今日" Style="{StaticResource ScopeToggle}"
                          IsChecked="{Binding IsScopeToday, Mode=OneWay}"
                          Command="{Binding SetScopeCommand}" CommandParameter="today"/>
            <ToggleButton Content="今週" Style="{StaticResource ScopeToggle}"
                          IsChecked="{Binding IsScopeWeek, Mode=OneWay}"
                          Command="{Binding SetScopeCommand}" CommandParameter="week"/>
            <ToggleButton Content="今月" Style="{StaticResource ScopeToggle}"
                          IsChecked="{Binding IsScopeMonth, Mode=OneWay}"
                          Command="{Binding SetScopeCommand}" CommandParameter="month"/>
            <ToggleButton Content="全期間" Style="{StaticResource ScopeToggle}"
                          IsChecked="{Binding IsScopeAll, Mode=OneWay}"
                          Command="{Binding SetScopeCommand}" CommandParameter="all"/>
        </StackPanel>

        <!-- 進捗 -->
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource TextSubBrush}" Margin="0,0,0,6"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
        </StackPanel>

        <!-- プロジェクト別リスト -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="2">
            <Grid>
                <ListView ItemsSource="{Binding ProjectSummaries}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="プロジェクト" Width="320"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="累計" Width="160"
                                            DisplayMemberBinding="{Binding TotalString}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <!-- 空状態 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoProjects}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="まだ記録がありません"
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="対象アプリを起動するか「開始」を押すと計測が始まります"
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="11"
                               Opacity="0.7"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- フッタ -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="WorkTime — log: data/logs/YYYY-MM.csv"
                       Foreground="{StaticResource TextSubBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="今月CSVを開く" Style="{StaticResource GhostButton}" Click="OnOpenCsv"/>
        </Grid>
    </Grid>
</Window>

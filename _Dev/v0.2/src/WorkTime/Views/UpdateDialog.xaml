<Window x:Class="WorkTime.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime — 更新"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadText"
                   Text="新しいバージョンがあります"
                   FontSize="20" FontWeight="SemiBold"/>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="現在" Foreground="{StaticResource TextMutedBrush}" Width="56"/>
                    <TextBlock Grid.Column="1" x:Name="CurrentText"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSubBrush}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最新" Foreground="{StaticResource TextMutedBrush}" Width="56"/>
                    <TextBlock Grid.Column="1" x:Name="LatestText"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextBrush}"/>
                </Grid>
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource TextSubBrush}"
                           TextWrapping="Wrap" FontSize="12"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="更新すると WorkTime を再起動します。計測中のセッションはそこで区切られます。設定とログは保持されます。"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <!-- 進捗 (更新中のみ表示) -->
        <StackPanel Grid.Row="3" x:Name="ProgressArea" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="ProgressText"
                       Text="ダウンロード中…"
                       Foreground="{StaticResource TextSubBrush}"
                       FontSize="12" Margin="0,0,0,8"/>
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="LaterButton" Content="後で" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="OnLater"/>
            <Button x:Name="UpdateButton" Content="更新する" Style="{StaticResource PrimaryButton}"
                    Click="OnUpdate"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="WorkTime.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime — 集計エクスポート"
        Width="640" Height="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="集計エクスポート" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- 期間 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="期間" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="開始日" Foreground="{StaticResource TextSubBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="終了日" Foreground="{StaticResource TextSubBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="今日" Style="{StaticResource GhostButton}" Click="OnPresetToday" Margin="0,0,6,0"/>
                    <Button Content="今週" Style="{StaticResource GhostButton}" Click="OnPresetWeek" Margin="0,0,6,0"/>
                    <Button Content="今月" Style="{StaticResource GhostButton}" Click="OnPresetMonth" Margin="0,0,6,0"/>
                    <Button Content="先月" Style="{StaticResource GhostButton}" Click="OnPresetLastMonth" Margin="0,0,6,0"/>
                    <Button Content="全期間" Style="{StaticResource GhostButton}" Click="OnPresetAll"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 一括チェック -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
            <TextBlock Text="プロジェクト" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="全選択" Style="{StaticResource GhostButton}" Click="OnSelectAll" Margin="0,0,6,0"/>
            <Button Content="全解除" Style="{StaticResource GhostButton}" Click="OnSelectNone"/>
        </StackPanel>

        <!-- プロジェクト一覧 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="2">
            <ListView ItemsSource="{Binding Projects}" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="プロジェクト" Width="280"
                                        DisplayMemberBinding="{Binding ProjectKey}"/>
                        <GridViewColumn Header="セッション数" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SessionCount}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="累計" Width="140"
                                        DisplayMemberBinding="{Binding TotalString}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 合計表示 -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="選択中の合計" Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedTotalString}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="28" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="セッション数" Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SelectedSessionCount}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="閉じる" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnClose"/>
            <Button Content="CSV エクスポート" Style="{StaticResource PrimaryButton}" Click="OnExport"/>
        </StackPanel>
    </Grid>
</Window>

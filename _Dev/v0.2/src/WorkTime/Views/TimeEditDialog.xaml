<Window x:Class="WorkTime.Views.TimeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime — 開始時刻の修正"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="開始時刻の修正" FontSize="18" FontWeight="Bold"/>

        <TextBlock Grid.Row="1"
                   Text="現在のセッションの開始打刻を HH:mm:ss で入力してください。"
                   Foreground="{StaticResource TextSubBrush}"
                   FontSize="11" TextWrapping="Wrap"
                   Margin="0,6,0,12"/>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14">
            <TextBox x:Name="TimeBox" FontSize="18"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>

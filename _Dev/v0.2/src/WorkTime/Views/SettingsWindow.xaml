<Window x:Class="WorkTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTime — 設定"
        Width="700" Height="900"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 見出し -->
            <RowDefinition Height="Auto"/>
            <!-- 監視対象プロセス -->
            <RowDefinition Height="Auto"/>
            <!-- 監視フォルダ -->
            <RowDefinition Height="Auto"/>
            <!-- アイドル/目標 -->
            <RowDefinition Height="Auto"/>
            <!-- 録画 -->
            <RowDefinition Height="Auto"/>
            <!-- フラグ群 -->
            <RowDefinition Height="Auto"/>
            <!-- ボタン -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- 監視対象プロセス -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12" MinHeight="190" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="監視対象プロセス" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="起動中のアプリから選択…" Style="{StaticResource GhostButton}"
                                ToolTip="今開いているアプリの一覧から監視対象を選びます"
                                Margin="0,0,8,0"
                                Click="OnPickRunningApps"/>
                        <Button Content="+ 追加" Style="{StaticResource GhostButton}"
                                Command="{Binding AddProcessCommand}"/>
                    </StackPanel>
                </Grid>
                <ListView ItemsSource="{Binding Processes}" BorderThickness="0" Background="Transparent" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="有効" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="プロセス名 (拡張子なし)" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="表示名" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="削除"
                                                Style="{StaticResource GhostButton}"
                                                Padding="6,2"
                                                Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- 監視フォルダ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="監視フォルダ" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="+ 追加" Style="{StaticResource GhostButton}"
                            Command="{Binding AddFolderCommand}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Text="このフォルダ配下のファイルを開いていると自動で計測を開始します。"
                           Foreground="{StaticResource TextSubBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListView ItemsSource="{Binding Folders}" BorderThickness="0" Background="Transparent" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="有効" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="フォルダ" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="参照…"
                                                Style="{StaticResource GhostButton}"
                                                Padding="6,2"
                                                Tag="{Binding}"
                                                Click="OnBrowseFolder"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="表示名" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="削除"
                                                Style="{StaticResource GhostButton}"
                                                Padding="6,2"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- アイドル/目標 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="アイドル閾値 (分, 0=無効)" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.IdleThresholdMinutes}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="今日の目標 (時間)" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.DailyTargetHours}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="今週の目標 (時間)" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.WeeklyTargetHours}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="今月の目標 (時間)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.MonthlyTargetHours}"/>
            </Grid>
        </Border>

        <!-- 録画 -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="録画" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox Content="録画を有効にする" IsChecked="{Binding Recording.Enabled}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="出力先" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="RecordingOutputRootBox"
                             Text="{Binding Recording.OutputRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="参照…" Style="{StaticResource GhostButton}"
                            Click="OnBrowseRecordingRoot" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="撮影 fps" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Recording.Fps}"/>
                    <TextBlock Grid.Column="2" Text="長辺 (px)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding Recording.LongEdge}"/>
                    <TextBlock Grid.Column="4" Text="CRF" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox Grid.Column="5" Text="{Binding Recording.Crf}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="エンコーダ" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Encoders}"
                              SelectedItem="{Binding Recording.Encoder}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="クリップ目標 (秒)" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding Recording.ClipTargetSeconds}"/>
                </Grid>
                <CheckBox Content="アイドル中は録画を一時停止する"
                          IsChecked="{Binding Recording.PauseOnIdle}" Margin="0,0,0,4"/>
                <CheckBox Content="セッション終了時にクリップを自動生成する"
                          IsChecked="{Binding Recording.AutoClipOnSessionEnd}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ffmpeg パス" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Recording.FfmpegPath}"/>
                </Grid>
                <TextBlock Text="空欄なら PATH 上の ffmpeg を使用します。実行ファイルまたはフォルダを指定できます。"
                           Foreground="{StaticResource TextSubBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- フラグ群 -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <CheckBox Content="ウィンドウを閉じたらトレイへ最小化"
                      IsChecked="{Binding Config.MinimizeToTrayOnClose}"
                      Margin="0,0,0,4"/>
            <CheckBox Content="OS 起動時に自動起動 (HKCU\Run)"
                      IsChecked="{Binding Config.LaunchAtStartup}"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>

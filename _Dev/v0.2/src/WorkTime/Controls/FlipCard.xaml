<UserControl x:Class="WorkTime.Controls.FlipCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="140">
    <!-- 外側のドロップシャドウは使わない。ヘアライン境界と上端 1px の
         ハイライトだけで段差を出す ("keyboard key" 表現) -->
    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上端のインセットハイライト -->
            <Rectangle Grid.Row="0" Grid.RowSpan="2"
                       Height="1"
                       VerticalAlignment="Top"
                       Margin="8,0"
                       Fill="{DynamicResource InsetHighlightBrush}"/>

            <Grid Grid.Row="0">
                <TextBlock x:Name="ValueText"
                           Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="{DynamicResource UiFont}"
                           FontWeight="SemiBold"
                           FontSize="78"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <!-- フリップ時計の分割線 -->
                <Rectangle Height="1"
                           Fill="{DynamicResource BorderBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       FontSize="11"/>
        </Grid>
    </Border>
</UserControl>
